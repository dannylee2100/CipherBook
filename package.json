{
  "name": "cipherbook-validation-laboratories",
  "version": "0.0.0-experimental",
  "private": true,
  "description": "Disposable CipherBook validation laboratories",
  "type": "module",
  "scripts": {
    "lab": "node experiments/milestone-1/src/cli.js",
    "measure": "node experiments/milestone-1/src/cli.js compare measure",
    "lab:2a:dev": "vite --config experiments/milestone-2a/vite.config.js",
    "lab:2a:build": "vite build --config experiments/milestone-2a/vite.config.js",
    "lab:2b:dev": "vite --config experiments/milestone-2b/vite.config.js",
    "lab:2b:build": "vite build --config experiments/milestone-2b/vite.config.js",
    "alpha:dev": "vite --config alpha/web/vite.config.js",
    "alpha:build": "vite build --config alpha/web/vite.config.js",
    "prealpha:preview": "npm run alpha:build",
    "alpha:preview": "vite preview --config alpha/web/vite.config.js --host 127.0.0.1 --port 4175",
    "format": "prettier --write package.json \".github/workflows/*.yml\" \"docs/decisions/*.md\" \"experiments/milestone-1/**/*.{js,md}\" \"experiments/milestone-2a/**/*.{js,md,html,css}\" \"experiments/milestone-2b/**/*.{js,md,html,css}\" \"alpha/web/**/*.{js,md,html,css}\"",
    "format:check": "prettier --check package.json \".github/workflows/*.yml\" \"docs/decisions/*.md\" \"experiments/milestone-1/**/*.{js,md}\" \"experiments/milestone-2a/**/*.{js,md,html,css}\" \"experiments/milestone-2b/**/*.{js,md,html,css}\" \"alpha/web/**/*.{js,md,html,css}\"",
    "check:syntax": "node --check experiments/milestone-1/src/*.js && node --check experiments/milestone-1/test/*.test.js && node --check experiments/milestone-2a/src/*.js && node --check experiments/milestone-2a/test/*.js && node --check experiments/milestone-2a/vite.config.js && node --check experiments/milestone-2a/playwright.config.js && node --check experiments/milestone-2b/src/*.js && node --check experiments/milestone-2b/test/*.js && node --check experiments/milestone-2b/vite.config.js && node --check experiments/milestone-2b/playwright.config.js && node --check alpha/web/src/*.js && node --check alpha/web/test/*.js && node --check alpha/web/vite.config.js && node --check alpha/web/playwright.config.js",
    "test": "node --test --test-reporter spec experiments/milestone-1/test/*.test.js",
    "test:interop": "node --test --test-reporter spec experiments/milestone-1/test/interoperability.test.js",
    "test:policy": "node --test --test-reporter spec experiments/milestone-2a/test/policy.test.js",
    "test:browser": "playwright test --config experiments/milestone-2a/playwright.config.js",
    "test:browser:chromium": "playwright test browser-workflow.spec.js storage.spec.js --project=chromium --config experiments/milestone-2a/playwright.config.js",
    "test:browser:firefox": "playwright test browser-workflow.spec.js storage.spec.js --project=firefox --config experiments/milestone-2a/playwright.config.js",
    "test:cross-runtime": "playwright test interoperability.spec.js --project=chromium --project=firefox --config experiments/milestone-2a/playwright.config.js",
    "check:browser-build": "node experiments/milestone-2a/test/check-build.js",
    "test:study:unit": "node --test --test-reporter spec experiments/milestone-2b/test/*.test.js",
    "test:study:qr": "node --test --test-reporter spec experiments/milestone-2b/test/qr.test.js",
    "test:study:chromium": "playwright test --project=chromium --config experiments/milestone-2b/playwright.config.js",
    "test:study:firefox": "playwright test --project=firefox --config experiments/milestone-2b/playwright.config.js",
    "check:study-build": "node experiments/milestone-2b/test/check-build.js",
    "test:alpha:unit": "node --test --test-reporter spec alpha/web/test/*.test.js",
    "test:alpha:chromium": "playwright test --project=chromium --config alpha/web/playwright.config.js",
    "test:alpha:firefox": "playwright test --project=firefox --config alpha/web/playwright.config.js",
    "test:identity-file:unit": "node --test --test-reporter spec alpha/web/test/identity-file.test.js alpha/web/test/identity-file-input.test.js alpha/web/test/identity-file-download.test.js alpha/web/test/identity-state.test.js",
    "test:identity-file:chromium": "playwright test identity-file.spec.js identity-continuity.spec.js --project=chromium --config alpha/web/playwright.config.js",
    "test:identity-file:firefox": "playwright test identity-file.spec.js identity-continuity.spec.js --project=firefox --config alpha/web/playwright.config.js",
    "measure:identity-file": "playwright test identity-file-performance.spec.js --project=chromium --project=firefox --config alpha/web/playwright.config.js",
    "check:alpha-build": "node alpha/web/test/build-check.js",
    "check": "npm run format:check && npm run check:syntax && npm test && npm run test:policy"
  },
  "dependencies": {
    "@nuintun/qrcode": "5.0.3",
    "age-encryption": "0.3.0",
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "prettier": "3.9.5",
    "vite": "8.1.5"
  }
}
